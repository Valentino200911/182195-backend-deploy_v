    {
      "name": "50 · Crear libro SIN imagen (JSON de siempre)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"imagen queda en null\", () => pm.expect(pm.response.json().imagen).to.eql(null));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenCarla}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"libro sin tapa\",\n  \"isbn\": \"SIN-001\",\n  \"precio\": 10000,\n  \"stock\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/libros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros"
          ]
        },
        "description": "Lo de siempre sigue funcionando: la imagen es opcional."
      }
    },
    {
      "name": "51 · ⭐ Crear libro CON imagen",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 201\", function () { pm.response.to.have.status(201); });",
              "const libro = pm.response.json();",
              "pm.environment.set(\"libroImagenId\", libro._id);",
              "pm.environment.set(\"imagenUrl\", libro.imagen);",
              "pm.test(\"guardó una URL\", () => pm.expect(libro.imagen).to.be.a(\"string\"));",
              "pm.test(\"la URL es de Supabase\", () => pm.expect(libro.imagen).to.include(\"/storage/v1/object/public/\"));",
              "",
              "// form-data manda TODO como texto, pero el schema dice Number y Mongoose convierte",
              "pm.test(\"el precio llegó como número\", () => pm.expect(libro.precio).to.eql(25000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenCarla}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "titulo",
              "value": "rayuela ilustrada",
              "type": "text"
            },
            {
              "key": "isbn",
              "value": "IMG-001",
              "type": "text"
            },
            {
              "key": "precio",
              "value": "25000",
              "type": "text"
            },
            {
              "key": "stock",
              "value": "5",
              "type": "text"
            },
            {
              "key": "genero",
              "value": "novela",
              "type": "text"
            },
            {
              "key": "imagen",
              "type": "file",
              "src": [],
              "description": "Elegí una imagen de tu compu"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/libros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros"
          ]
        },
        "description": "Body → form-data. En la fila 'imagen' apretá 'Select Files' y elegí una foto.\nDespués abrí la URL que devuelve: la imagen ya está en Supabase."
      }
    },
