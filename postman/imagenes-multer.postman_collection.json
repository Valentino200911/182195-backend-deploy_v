    {
      "name": "58 · ⭐ Cambiar la tapa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"cambió la URL\", () => pm.expect(pm.response.json().imagen).to.not.eql(pm.environment.get(\"imagenUrl\")));",
              "pm.environment.set(\"imagenUrl\", pm.response.json().imagen);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenCarla}}"
