# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env
#
# El .env NO se sube a git (está en .gitignore): tiene la conexión real.
# ⚠️ Los comentarios van con #, no con //


# ─────────────────────────────────────────────────────────────
#  LA BASE DE DATOS
#
#  Dejá UNA sola línea MONGO_URI sin comentar. La otra, con #.
# ─────────────────────────────────────────────────────────────

# 1 · LOCAL · la de siempre, la base corre en tu máquina
MONGO_URI=mongodb://localhost:27017/biblioteca

# 2 · ATLAS (nube) · clase 26
#    El string se copia de: Atlas → Connect → Drivers.
#    Viene así, con cosas para reemplazar:
#
#    mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
#    · <usuario> y <password> son los del usuario de BASE DE DATOS
#      (Atlas → Database Access), NO el mail con el que entrás a Atlas.
#
#    · ⚠️ Hay que agregarle el NOMBRE DE LA BASE, que el string no lo trae.
#      Va después del .net/ y antes del ? :
#
#        ...mongodb.net/biblioteca?retryWrites=true&w=majority
#
#      Si no se lo ponés, Mongo usa una base llamada "test" y vas a jurar
#      que el seed no funcionó.
#
#    · ⚠️ Si la contraseña tiene @ : / ? # o %, hay que escaparla.
#      Lo más simple: generala sin símbolos con "Autogenerate Secure Password".
#
#    · Sin comillas y sin espacios alrededor del = .
#
# MONGO_URI=mongodb+srv://alumno:MiClave123@cluster0.xxxxx.mongodb.net/biblioteca?retryWrites=true&w=majority

#  Para probar que la conexión anda, sin levantar el servidor:
#      npm run db:ping


PORT=3000

# Sin espacios alrededor del = . "PORT = 300" funciona, pero 300 es un puerto
# reservado del sistema: usamos 3000.


# ─────────────────────────────────────────────────────────────
#  EL TOKEN
# ─────────────────────────────────────────────────────────────

# Con qué se firman los tokens. Si no lo ponés, config.js usa uno de clase.
# En un proyecto de verdad es obligatorio, y distinto en cada entorno.
JWT_SECRET=
JWT_EXPIRA=2h


# ─────────────────────────────────────────────────────────────
#  LAS IMÁGENES (clase 23)
# ─────────────────────────────────────────────────────────────

# local = una carpeta de tu máquina · supabase = el storage en la nube
STORAGE=local
CARPETA_IMAGENES=uploads

# Solo hacen falta con STORAGE=supabase
SUPABASE_URL=
SUPABASE_KEY=
